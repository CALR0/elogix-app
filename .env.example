# Copia este archivo a .env.local y completa los valores.
# 🚨 Solo las variables NEXT_PUBLIC_* llegan al navegador. El resto es server-only.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...          # Ignora RLS. NUNCA al cliente.

# TusDatos
# simulado = las consultas NO salen a TusDatos ni gastan créditos (resultados de prueba).
# real     = usa la API; exige credenciales, TUSDATOS_WEBHOOK_TOKEN y CRON_SECRET.
TUSDATOS_MODO=simulado
TUSDATOS_BASE_URL=https://dash-board.tusdatos.co
# Usa el token O email + password (solo en modo real)
TUSDATOS_API_TOKEN=
TUSDATOS_EMAIL=
TUSDATOS_PASSWORD=

# Token Bearer que TusDatos envía a /api/webhooks/tusdatos (se registra con auth_type=BearerAuth).
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TUSDATOS_WEBHOOK_TOKEN=

# Protege /api/cron/* (Vercel Cron lo envía como Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Sentry (opcional)
SENTRY_DSN=

# Muestra los accesos de prueba (usuario/admin) en el login. Quitar al conectar Supabase Auth.
NEXT_PUBLIC_MODO_DEMO=false
